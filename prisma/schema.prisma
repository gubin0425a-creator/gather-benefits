generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(uuid())
  viewCount     Int      @default(0)
  isPremium     Boolean  @default(false)
  lastResetTime DateTime @default(now())
  createdAt     DateTime @default(now())
}
